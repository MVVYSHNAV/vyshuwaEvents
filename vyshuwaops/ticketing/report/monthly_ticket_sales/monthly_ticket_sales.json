 "module": "Ticketing",
 "name": "Monthly Ticket Sales",
 "owner": "Administrator",
 "prepared_report": 0,
 "query": "SELECT\n  DATE_FORMAT(t.creation, '%%Y-%%m-%%d') AS \"Day\",\n  COUNT(t.name) AS \"Tickets Sold\",\n  SUM(t.price) AS \"Total Revenue\",\n  b.user AS \"Customer\",\n  b.event AS \"Event\"\nFROM\n  `tabFesta Ticket` AS t\nJOIN\n  `tabFesta Booking` AS b\n  ON t.booking = b.name\nGROUP BY\n  DATE_FORMAT(t.creation, '%%Y-%%m-%%d'),\n  b.user,\n  b.event\nORDER BY\n  DATE_FORMAT(t.creation, '%%Y-%%m-%%d');\n",
