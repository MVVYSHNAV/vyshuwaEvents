 "prepared_report": 0,
 "query": "SELECT\n  DATE_FORMAT(t.creation, '%%Y-%%m') AS \"Month\",\n  COUNT(t.name) AS \"Tickets Sold\",\n  SUM(t.price) AS \"Total Revenue\"\nFROM\n  `tabFesta Ticket` AS t\nJOIN\n  `tabFesta Booking` AS b\n  ON t.booking = b.name\nGROUP BY\n  DATE_FORMAT(t.creation, '%%Y-%%m')\nORDER BY\n  DATE_FORMAT(t.creation, '%%Y-%%m');\n",
