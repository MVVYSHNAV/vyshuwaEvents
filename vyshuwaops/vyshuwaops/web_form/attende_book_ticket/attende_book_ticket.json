{
 "doctype": "Web Form",
 "module": "Vyshuwaops",
 "title": "Book Event Tickets",
 "route": "book-tickets",
 "doc_type": "Festa Booking",
 "is_standard": 1,
 "is_multi_step_form": 0,
 "allow_edit": 0,
 "allow_delete": 0,
 "allow_print": 0,
 "print_format": 0,
 "allow_comments": 0,
 "show_attachments": 0,
 "show_list": 0,
