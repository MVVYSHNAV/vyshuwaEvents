 "login_required": 0,
 "web_form_fields": [
  {
   "fieldname": "event",
   "fieldtype": "Link",
   "label": "Event",
   "options": "Festa Event",
   "reqd": 1,
   "show_in_filter": 1
  },
  {
   "fieldname": "user",
   "fieldtype": "Link",
   "label": "User",
   "options": "User",
   "reqd": 1,
   "hidden": 1,
   "default": "{{ frappe.session.user }}"
  },
  {
   "fieldname": "attendes",
   "fieldtype": "Table",
   "label": "Attendees",
   "options": "Festa Attende Booking",
   "reqd": 1
  },
  {
   "fieldname": "total_amount",
   "fieldtype": "Currency",
   "label": "Total Amount",
   "read_only": 1,
   "hidden": 1
  },
  {
   "fieldname": "currency",
   "fieldtype": "Link",
   "label": "Currency",
   "options": "Currency",
   "read_only": 1,
   "hidden": 1
  },
  {
   "fieldname": "payment_status",
   "fieldtype": "Select",
   "label": "Payment Status",
   "options": "Pending\nPaid\nFailed",
   "default": "Pending",
   "read_only": 1,
   "hidden": 1
  }
 ],
 "condition": "",
 "list_columns": [],
 "show_sidebar": 0,
 "button_label": "Book Tickets",
 "accept_payment": 1,
 "payment_button_label": "Pay Now",
 "amount_based_on_field": "total_amount",
