 "client_script": "frappe.web_form.on('attendes', {\n    ticket: function(frm, cdt, cdn) {\n        let row = locals[cdt][cdn];\n        if (row.ticket) {\n            frappe.db.get_value('Festa Ticket Type', row.ticket, ['price', 'currency'], (r) => {\n                if (r && r.price) {\n                    row.price = flt(r.price);\n                    row.currency = r.currency || frappe.web_form.get_value('currency');\n                    frappe.web_form.refresh_field('attendes');\n                    update_total_amount();\n                }\n            });\n        } else {\n            row.price = 0;\n            frappe.web_form.refresh_field('attendees');\n            update_total_amount();\n        }\n    }\n});\n",
